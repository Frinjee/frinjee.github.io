# Cloudflare Pages custom headers
# GitHub Pages ignores this file — harmless to commit.
# Cloudflare Pages applies it to all matched paths.

# immutable data bundles — cached forever by hash-named URL
/hoard/data.*.json.gz
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/json
  Content-Encoding: gzip

/hoard/my/data.json.gz
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/json
  Content-Encoding: gzip

# version manifest — always revalidate
/hoard/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# HTML pages — short-lived
/*.html
  Cache-Control: no-cache

/hoard/*.html
  Cache-Control: no-cache

/hoard/my/*.html
  Cache-Control: no-cache
